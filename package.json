{
  "name": "postgres-pool",
  "version": "12.0.1",
  "description": "Node postgres connection pool implementation for node-pg",
  "keywords": [
    "connection",
    "node",
    "pg",
    "pool",
    "pooling",
    "postgres"
  ],
  "homepage": "https://github.com/postgres-pool/postgres-pool#readme",
  "bugs": {
    "url": "https://github.com/postgres-pool/postgres-pool/issues"
  },
  "license": "MIT",
  "author": "Jim Geurts <jim@biacreations.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/postgres-pool/postgres-pool.git"
  },
  "files": [
    "certs",
    "dist",
    "src",
    "!**/*.test.ts"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "vp pack && cp -R certs dist",
    "test": "pnpm run test:types && vp test run",
    "test:types": "tsc --noEmit --skipLibCheck",
    "format": "vp fmt",
    "lint:code": "vp lint --fix --fix-suggestions --deny-warnings",
    "lint:markdown": "markdownlint '*.md' '!(node_modules|dist)/**/*.md' --config=.github/linters/.markdown-lint.yml --fix",
    "lint": "pnpm run format && run-p lint:*",
    "lint-staged": "lint-staged",
    "docker:up": "docker-compose -f .devcontainer/docker-compose.yml up -d",
    "docker:down": "docker-compose -f .devcontainer/docker-compose.yml down",
    "beta": "pnpm publish --tag beta --no-git-checks",
    "prepublishOnly": "pinst --disable",
    "postpublish": "pinst --enable",
    "prepare": "husky"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "14.0.0-beta.4",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "15.0.0-beta.3",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": ">=22",
    "@types/pg": "8.23.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/eslint-plugin": "1.6.27",
    "conventional-changelog-conventionalcommits": "10.4.0",
    "eslint": "10.11.0",
    "eslint-plugin-jsdoc": "64.5.4",
    "eslint-plugin-security": "4.0.1",
    "eslint-plugin-unicorn": "76.0.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "markdownlint-cli": "0.49.1",
    "npm-run-all2": "9.0.3",
    "oxlint": "1.82.0",
    "oxlint-config-decent": "5.0.0",
    "oxlint-plugin-eslint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "pg": "8.23.0",
    "pinst": "3.0.0",
    "semantic-release": "25.0.9",
    "strict-event-emitter-types": "2.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite-plus": "0.3.1",
    "vitest": "5.0.1"
  },
  "peerDependencies": {
    "pg": "^8.0.0"
  },
  "lint-staged": {
    "*.md": [
      "vp fmt --no-error-on-unmatched-pattern",
      "markdownlint --config=.github/linters/.markdown-lint.yml --fix"
    ],
    "*.{js,cjs,mjs,ts}": [
      "vp fmt --no-error-on-unmatched-pattern",
      "vp lint --fix --fix-suggestions --deny-warnings"
    ],
    "*.{json,json5,yml,yaml}": [
      "vp fmt --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
}
